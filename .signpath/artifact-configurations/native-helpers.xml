  Exact relative paths inside the GitHub Actions uploaded ZIP are required.
  Only OpenShell-built binaries are eligible; never sign upstream third-party files.
  These helper PEs do not embed the Wails/NSIS product-version resource fields.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="rz.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="sz.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="native/zmodem-sidecar.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
